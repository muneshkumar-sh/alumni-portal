<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alumni Registration</title>


    <style>
        /* =========================
           GENERAL
        ========================= */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;

            font-family: Arial, Helvetica, sans-serif;

            background: #f1f5f9;

            color: #1e293b;
        }


        /* =========================
           MAIN CONTAINER
        ========================= */

        .container {
            width: 92%;
            max-width: 1000px;

            margin: 40px auto;
        }


        /* =========================
           HEADER
        ========================= */

        .header {
            background: white;

            padding: 28px;

            margin-bottom: 25px;

            border-radius: 12px;

            text-align: center;

            box-shadow:
                0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .header h1 {
            margin: 0 0 8px 0;

            color: #1e3a8a;

            font-size: 30px;
        }

        .header p {
            margin: 0;

            color: #64748b;

            font-size: 15px;
        }


        /* =========================
           FORM
        ========================= */

        form {
            background: white;

            padding: 35px;

            border-radius: 12px;

            box-shadow:
                0 3px 12px rgba(0, 0, 0, 0.08);
        }


        /* =========================
           SECTION HEADINGS
        ========================= */

        form h2 {
            margin: 30px 0 20px 0;

            padding-bottom: 10px;

            border-bottom: 2px solid #e2e8f0;

            color: #1e3a8a;

            font-size: 20px;
        }

        form h2:first-child {
            margin-top: 0;
        }


        /* =========================
           GRID
        ========================= */

        .grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;

            margin-bottom: 10px;
        }


        /* =========================
           LABELS
        ========================= */

        form>label,
        .grid label,
        .upload-box>label {
            display: block;

            margin-bottom: 7px;

            font-weight: bold;

            color: #334155;

            font-size: 14px;
        }


        /* =========================
           INPUTS
        ========================= */

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"],
        input[type="number"],
        input[type="url"],
        input[type="file"],
        select,
        textarea {

            width: 100%;

            padding: 11px 12px;

            border: 1px solid #cbd5e1;

            border-radius: 7px;

            background: white;

            color: #1e293b;

            font-size: 15px;

            font-family: inherit;
        }


        /* =========================
           TEXTAREA
        ========================= */

        textarea {
            min-height: 120px;

            resize: vertical;

            line-height: 1.5;

            margin-bottom: 10px;
        }


        /* =========================
           INPUT FOCUS
        ========================= */

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="tel"]:focus,
        input[type="number"]:focus,
        input[type="url"]:focus,
        select:focus,
        textarea:focus {

            outline: none;

            border-color: #2563eb;

            box-shadow:
                0 0 0 2px rgba(37, 99, 235, 0.10);
        }


        /* =========================
           RADIO + CHECKBOX OPTIONS
        ========================= */

        .options {

            display: flex;

            align-items: center;

            gap: 25px;

            margin: 8px 0 20px 0;
        }


        .options label {

            display: flex;

            align-items: center;

            gap: 8px;

            margin: 0;

            font-weight: normal;

            color: #334155;

            cursor: pointer;
        }


        .options input[type="radio"],
        .options input[type="checkbox"] {

            width: 17px;

            height: 17px;

            margin: 0;

            padding: 0;

            flex-shrink: 0;

            accent-color: #2563eb;

            cursor: pointer;
        }


        /* =========================
           SKILLS
        ========================= */

        .options.wrap {

            flex-wrap: wrap;

            gap: 12px 25px;

            padding: 15px;

            background: #f8fafc;

            border: 1px solid #e2e8f0;

            border-radius: 8px;
        }


        .options.wrap label {

            min-width: 100px;
        }


        /* =========================
           FILE UPLOAD
        ========================= */

        .upload-box {

            padding: 20px;

            background: #f8fafc;

            border: 1px dashed #94a3b8;

            border-radius: 8px;

            margin-bottom: 10px;
        }


        .upload-box input[type="file"] {

            background: white;

            cursor: pointer;
        }


        .upload-box small {

            display: block;

            margin-top: 8px;

            color: #64748b;

            font-size: 13px;
        }


        /* =========================
           BUTTONS
        ========================= */

        .buttons {

            display: flex;

            gap: 12px;

            margin-top: 30px;

            padding-top: 20px;

            border-top: 1px solid #e2e8f0;
        }


        .buttons button {

            padding: 12px 22px;

            border: none;

            border-radius: 7px;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;
        }


        .buttons button[type="submit"] {

            background: #2563eb;

            color: white;
        }


        .buttons button[type="submit"]:hover {

            background: #1d4ed8;
        }


        .buttons .reset {

            background: #e2e8f0;

            color: #334155;
        }


        .buttons .reset:hover {

            background: #cbd5e1;
        }

        .login-button {
            display: inline-block;
            padding: 12px 20px;
            background-color: #475569;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .login-button:hover {
            background-color: #334155;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 700px) {

            .container {
                width: 95%;

                margin: 20px auto;
            }

            form {
                padding: 22px;
            }

            .grid {
                grid-template-columns: 1fr;

                gap: 15px;
            }

            .options {
                flex-direction: column;

                align-items: flex-start;

                gap: 12px;
            }

            .options.wrap {
                flex-direction: column;

                align-items: flex-start;
            }

            .buttons {
                flex-direction: column;
            }

            .buttons button {
                width: 100%;
            }
        }
    </style>

</head>


<body>


    <div class="container">


        <!-- =========================
         HEADER
    ========================= -->

        <div class="header">

            <h1>
                Alumni Registration
            </h1>

            <p>
                Join the Alumni Portal
            </p>

        </div>


        <!-- =========================
         REGISTRATION FORM
    ========================= -->

        <form action="/register" method="POST" enctype="multipart/form-data">


            <!-- ================= PERSONAL ================= -->

            <h2>
                1. Personal Information
            </h2>


            <div class="grid">

                <div>

                    <label>
                        Full Name *
                    </label>

                    <input type="text" name="full_name" required>

                </div>


                <div>

                    <label>
                        Email *
                    </label>

                    <input type="email" name="email" required>

                </div>


                <div>

                    <label>
                        Password *
                    </label>

                    <input type="password" name="password" minlength="6" required>

                </div>


                <div>

                    <label>
                        Phone
                    </label>

                    <input type="tel" name="phone" placeholder="+92xxxxxxxxxx">

                </div>

            </div>


            <label>
                Gender
            </label>

            <div class="options">

                <label>

                    <input type="radio" name="gender" value="Male">

                    Male

                </label>


                <label>

                    <input type="radio" name="gender" value="Female">

                    Female

                </label>

            </div>


            <!-- ================= ACADEMIC ================= -->

            <h2>
                2. Academic Information
            </h2>


            <div class="grid">


                <div>

                    <label>
                        Department
                    </label>

                    <select name="department">

                        <option value="">
                            Select Department
                        </option>

                        <option>
                            Computer Science
                        </option>

                        <option>
                            Information Technology
                        </option>

                        <option>
                            Software Engineering
                        </option>

                        <option>
                            Electrical Engineering
                        </option>

                        <option>
                            Business Administration
                        </option>

                    </select>

                </div>


                <div>

                    <label>
                        Graduation Year
                    </label>

                    <select name="graduation_year">

                        <option value="">
                            Select Year
                        </option>

                        <option>2022</option>
                        <option>2023</option>
                        <option>2024</option>
                        <option>2025</option>
                        <option>2026</option>

                    </select>

                </div>


                <div>

                    <label>
                        CGPA
                    </label>

                    <input type="number" name="cgpa" min="0" max="4" step="0.01">

                </div>


            </div>


            <label>
                Degree Program
            </label>

            <div class="options">

                <label>

                    <input type="radio" name="degree_program" value="BS">

                    BS

                </label>


                <label>

                    <input type="radio" name="degree_program" value="MS">

                    MS

                </label>


                <label>

                    <input type="radio" name="degree_program" value="PhD">

                    PhD

                </label>

            </div>


            <!-- ================= PROFESSIONAL ================= -->

            <h2>
                3. Professional Information
            </h2>


            <div class="grid">


                <div>

                    <label>
                        Employment Status
                    </label>

                    <select name="employment_status">

                        <option value="">
                            Select Status
                        </option>

                        <option>
                            Student
                        </option>

                        <option>
                            Employed
                        </option>

                        <option>
                            Self Employed
                        </option>

                        <option>
                            Unemployed
                        </option>

                    </select>

                </div>


                <div>

                    <label>
                        Company / Organization
                    </label>

                    <input type="text" name="company">

                </div>


                <div>

                    <label>
                        Job Title
                    </label>

                    <input type="text" name="job_title">

                </div>


            </div>


            <label>
                Skills
            </label>


            <div class="options wrap">


                <label>

                    <input type="checkbox" name="skills" value="HTML">

                    HTML

                </label>


                <label>

                    <input type="checkbox" name="skills" value="CSS">

                    CSS

                </label>


                <label>

                    <input type="checkbox" name="skills" value="JavaScript">

                    JavaScript

                </label>


                <label>

                    <input type="checkbox" name="skills" value="Node.js">

                    Node.js

                </label>


                <label>

                    <input type="checkbox" name="skills" value="PHP">

                    PHP

                </label>


                <label>

                    <input type="checkbox" name="skills" value="Python">

                    Python

                </label>


                <label>

                    <input type="checkbox" name="skills" value="MySQL">

                    MySQL

                </label>


            </div>


            <!-- ================= PROFILE ================= -->

            <h2>
                4. Profile Information
            </h2>


            <div class="grid">

                <div>

                    <label>
                        LinkedIn Profile
                    </label>

                    <input type="url" name="linkedin" placeholder="https://linkedin.com/in/username">

                </div>

            </div>


            <label>
                Short Bio
            </label>

            <textarea name="bio" rows="5" placeholder="Write a short introduction..."></textarea>


            <!-- ================= IMAGE ================= -->

            <h2>
                5. Profile Image
            </h2>


            <div class="upload-box">

                <label>
                    Profile Image
                </label>

                <input type="file" name="profile_image" accept="image/png,image/jpeg,image/gif" required>

                <small>
                    Allowed: JPG, JPEG, PNG, GIF.
                    Maximum 2 MB.
                </small>

            </div>


            <!-- ================= CONFIRMATION ================= -->

            <h2>
                6. Confirmation
            </h2>


            <div class="options">

                <label>

                    <input type="checkbox" name="terms_accepted" value="1" required>

                    I agree to the Terms & Conditions *

                </label>

            </div>


            <!-- ================= BUTTONS ================= -->

            <div class="buttons">

                <button type="submit">
                    Create Account
                </button>

                <button type="reset" class="reset">
                    Reset Form
                </button>

                <a href="/" class="login-button">
                    Return to Login
                </a>

            </div>


        </form>


    </div>


</body>

</html>